WORKOS_API_KEY=sk_test_replace_me
WORKOS_CLIENT_ID=client_replace_me
WORKOS_COOKIE_PASSWORD=replace-with-32-plus-random-characters
ADMIN_BASE_URL=http://127.0.0.1:3000
PUBLIC_SITE_BASE_URL=https://peartree-community-school.github.io/peartree-website
WORKOS_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
# Optional if PearTree uses one WorkOS organization for all staff:
# WORKOS_ORGANIZATION_ID=org_replace_me
# Bootstrap super_admin access (comma-separated emails). Used ONLY when the users
# table is empty — auto-creates the first super_admin on first sign-in. After that
# the users table is the source of truth; this env can stay set but is ignored.
# ADMIN_BOOTSTRAP_EMAILS=admin@peartree.org,michele@peartree.org
# SQLite database path. Defaults to ./data/admin.sqlite (auto-created).
# ADMIN_DB_PATH=./data/admin.sqlite
# WorkOS webhook signing secret (Dashboard → Webhooks → Endpoint → Signing secret).
# If unset, the /webhooks/workos endpoint returns 503.
# WORKOS_WEBHOOK_SECRET=whsec_...
PORT=3000
