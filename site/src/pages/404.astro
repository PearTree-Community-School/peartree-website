---
import Layout from '../layouts/Layout.astro';

// Where people most often meant to land. Ordered by how commonly a broken or
// stale link to this site turns out to have been one of these.
const routes = [
  { href: '/admissions/', label: 'Admissions', desc: 'Enrolment steps, tuition and financial aid.' },
  { href: '/tour/', label: 'Schedule a Tour', desc: 'Come and see the classrooms in person.' },
  { href: '/programs/', label: 'Programs', desc: 'Preschool through 5th grade.' },
  { href: '/about/', label: 'About Us', desc: 'Our founder, our mission and the MIRROR framework.' },
  { href: '/parents/', label: 'Parent Portal', desc: 'ParentSquare links and the parent FAQ.' },
  { href: '/contact/', label: 'Contact', desc: 'Phone, email and both campus addresses.' },
];
---

<Layout
  title="Page Not Found"
  description="That page could not be found. Find admissions, tours, programs and contact details for Pear Tree Community School in Oakland."
>

  <!-- Page Header -->
  <section class="bg-forest-900 text-white">
    <div class="section-padding py-14 md:py-16">
      <p class="text-pear-400 font-semibold text-sm uppercase tracking-widest mb-4">Error 404</p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold leading-tight max-w-3xl">
        We couldn't find that page.
      </h1>
      <p class="text-lg text-forest-200 max-w-2xl mt-6 leading-relaxed">
        The link may be out of date, or the address may have a typo in it. Here is where most people are headed.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {routes.map(route => (
        <a
          href={route.href}
          class="block rounded-2xl border border-earth-100 bg-white p-6 transition-colors hover:border-forest-300 hover:bg-forest-50"
        >
          <span class="font-serif font-bold text-lg text-forest-800 block mb-1">{route.label}</span>
          <span class="text-sm text-earth-600">{route.desc}</span>
        </a>
      ))}
    </div>

    <p class="text-earth-600 mt-10">
      Still stuck? Email
      <a href="mailto:admin@peartreecs.com" class="text-forest-700 underline hover:text-forest-900">admin@peartreecs.com</a>
      or call
      <a href="tel:+15108174690" class="text-forest-700 underline hover:text-forest-900">(510) 817-4690</a>
      and we will point you the right way.
    </p>
  </section>

</Layout>
