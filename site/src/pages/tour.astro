---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import hero from '../assets/images/heroes/tour.jpg';
import { externalForms } from '../data/externalForms';
import { tourCopy } from '../data/tourInfo';
import { phone, phoneTel, email } from '../data/campusInfo';

---

<Layout title="Schedule a Tour" description="Schedule a campus tour at Pear Tree Community School. Weekly Thursday tours of our Oakland Montessori preschool and elementary.">

  <PageHero
    eyebrow="Visit Pear Tree"
    title="Schedule a tour of our campus."
    subtitle={`${tourCopy.schedule}. ${tourCopy.responseTime}`}
    image={hero}
    alt="Students in red performing on stage for their families"
  />

  <section class="section-padding">
    <div class="max-w-4xl mx-auto space-y-8">

      <!-- Request card: the one action on the page, so it goes first and full width -->
      <div class="bg-white rounded-2xl p-8 md:p-10 border border-earth-100 text-center">
        <h2 class="font-serif text-2xl md:text-3xl font-bold mb-3">Request a tour</h2>
        <p class="text-earth-700 max-w-xl mx-auto mb-6">
          {tourCopy.schedule}. Tell us a little about your family and {tourCopy.responseTime.charAt(0).toLowerCase() + tourCopy.responseTime.slice(1)}
        </p>
        <a href={externalForms.tour} target="_blank" rel="noopener"
          class="inline-block px-8 py-4 rounded-full bg-pear-500 hover:bg-pear-400 text-charcoal font-bold text-base">
          Open the tour request form
        </a>
        <p class="text-sm text-earth-700 mt-4">Opens in a new tab. Takes about two minutes.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-pear-50 border border-pear-200 rounded-2xl p-6">
          <h2 class="font-serif font-bold text-lg mb-3">What to expect</h2>
          <ul class="space-y-2 text-sm text-earth-700">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-forest-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
              <span>A walkthrough of our classrooms and outdoor spaces</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-forest-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
              <span>Time with our founder or admissions team to ask questions</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-forest-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
              <span>An honest conversation about financial aid options</span>
            </li>
          </ul>
        </div>

        <div class="bg-white border border-earth-100 rounded-2xl p-6">
          <h2 class="font-serif font-bold text-lg mb-3">Prefer to call?</h2>
          <p class="text-sm text-earth-700 mb-3">We're happy to chat by phone or email.</p>
          <p class="text-sm"><a href={phoneTel} class="tap-link text-forest-700 hover:text-forest-900 font-medium">{phone}</a></p>
          <p class="text-sm"><a href={`mailto:${email}`} class="tap-link text-forest-700 hover:text-forest-900 font-medium">{email}</a></p>
        </div>
      </div>
    </div>
  </section>

</Layout>
