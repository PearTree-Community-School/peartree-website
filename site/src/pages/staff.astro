  'Employee Handbook': 'M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25',
  'Code of Professional Conduct': 'M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z',
  'QuickBooks Workforce': 'M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z',
};

const steps = [
  { n: '1', title: 'Describe it', body: 'Pick a category, say where it is, and add a photo if it helps. Two minutes, tops.' },
  { n: '2', title: 'The office triages', body: 'The front office reviews new requests and sorts them by priority. Urgent items go first.' },
  { n: '3', title: 'You hear back', body: 'The office follows up with what is happening and when. If it has gone quiet, nudge us.' },
];
---

<Layout title="Staff Portal" description="Pear Tree Community School staff portal — submit work requests for facilities, supplies, tech, Montessori materials, and more.">

  <PageHero
    eyebrow="Staff Portal"
    title="Need something fixed, ordered, or booked?"
    subtitle="One form covers facilities, supplies, tech, Montessori materials, and everything else you need to do your job well."
    image={hero}
    alt="Students performing under papel picado at a school showcase"
  >
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href={externalForms.staff} target="_blank" rel="noopener" class="btn-primary bg-pear-500 hover:bg-pear-400 text-charcoal font-bold px-8 py-4 text-base">
        Open the request form
      </a>
      <span class="text-sm text-forest-200">Opens in a new tab. Takes about two minutes.</span>
    </div>
  </PageHero>

  <!-- How it works + urgent -->
  <section class="bg-white border-b border-earth-100">
    <div class="section-padding py-12 md:py-16">
      <div class="grid lg:grid-cols-3 gap-8 items-start">
        <div class="lg:col-span-2">
          <h2 class="font-serif text-2xl md:text-3xl font-bold text-charcoal mb-6">How a request moves</h2>
          <ol class="grid sm:grid-cols-3 gap-6">
            {steps.map(s => (
              <li class="relative pl-14">
                <span class="absolute left-0 top-0 w-10 h-10 rounded-full bg-forest-700 text-white font-serif font-bold text-lg flex items-center justify-center">{s.n}</span>
                <h3 class="font-serif font-bold text-lg text-charcoal mb-1">{s.title}</h3>
                <p class="text-sm text-earth-700 leading-relaxed">{s.body}</p>
              </li>
            ))}
          </ol>
        </div>

        <aside class="rounded-2xl border-2 border-pear-300 bg-pear-50 p-6">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-9 h-9 rounded-full bg-pear-500 text-charcoal flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/></svg>
            </span>
            <h2 class="font-serif font-bold text-lg text-charcoal">Dangerous or blocking class right now?</h2>
          </div>
          <p class="text-sm text-earth-700 mb-4">Don't wait on the form. Call the front office first, then log it so there is a record.</p>
          <a href={phoneTel} class="tap-link font-serif text-2xl font-bold text-forest-800 hover:text-forest-900">{phone}</a>
        </aside>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="section-padding">
    <div class="max-w-2xl mb-8">
      <h2 class="section-heading">What you can request</h2>
      <p class="text-earth-700">Every tile opens the same form. Pick the closest match and the office will route it.</p>
    </div>
    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {requestCategories.map(c => (
        <li>
          <a href={externalForms.staff} target="_blank" rel="noopener" class="group flex gap-4 h-full rounded-2xl border border-earth-100 bg-white p-5 hover:border-forest-400 hover:shadow-md transition-all">
            <span class="w-11 h-11 rounded-xl bg-forest-50 text-forest-700 flex items-center justify-center flex-shrink-0 group-hover:bg-forest-700 group-hover:text-white transition-colors">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={categoryIcons[c.id]}/></svg>
            </span>
            <span>
              <span class="block font-serif font-bold text-charcoal">{c.label}</span>
              <span class="block text-sm text-earth-700 mt-0.5 leading-relaxed">{c.desc}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <!-- Tips: the three things that make a request actionable on the first pass -->
    <div class="mt-8 rounded-2xl bg-forest-50 border border-forest-100 p-6 md:p-8">
      <h3 class="font-serif font-bold text-lg text-charcoal mb-4">Before you hit submit</h3>
      <ul class="grid sm:grid-cols-3 gap-4 text-sm text-earth-700">
        <li class="flex gap-3"><svg class="w-5 h-5 text-forest-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M4.5 12.75l6 6 9-13.5"/></svg><span><strong class="text-charcoal">Say exactly where.</strong> Classroom name and campus. "The sink" is not enough when there are five.</span></li>
        <li class="flex gap-3"><svg class="w-5 h-5 text-forest-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M4.5 12.75l6 6 9-13.5"/></svg><span><strong class="text-charcoal">Attach a photo.</strong> For facilities and tech it usually saves a follow-up visit.</span></li>
        <li class="flex gap-3"><svg class="w-5 h-5 text-forest-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M4.5 12.75l6 6 9-13.5"/></svg><span><strong class="text-charcoal">Set an honest priority.</strong> Marking everything urgent makes the truly urgent things wait.</span></li>
      </ul>
    </div>
  </section>

  <!-- Resources -->
  <section class="bg-white border-t border-earth-100">
    <div class="section-padding">
      <div class="max-w-2xl mb-8">
        <h2 class="section-heading">Staff resources</h2>
        <p class="text-earth-700">Handbooks, policies and payroll. Each opens in a new tab.</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-5">
        {staffResources.map((r) => (
          <a href={r.href} target="_blank" rel="noopener" class="group flex flex-col rounded-2xl border border-earth-100 bg-cream p-6 hover:border-forest-400 hover:shadow-md transition-all">
            <span class="w-11 h-11 rounded-xl bg-pear-100 text-pear-800 flex items-center justify-center mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={resourceIcons[r.label] ?? categoryIcons.other}/></svg>
            </span>
            <span class="font-serif font-bold text-lg text-charcoal mb-1">{r.label}</span>
            <span class="text-sm text-earth-700 flex-1">{r.desc}</span>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-forest-700 group-hover:underline">
              Open
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
            </span>
          </a>
        ))}
      </div>
      <p class="text-sm text-earth-700 mt-8">Missing a link you use every week? Email <a href={`mailto:${email}?subject=${encodeURIComponent('Staff portal: add a resource')}`} class="font-medium text-forest-700 underline underline-offset-2">{email}</a> and we will add it.</p>
    </div>
  </section>

</Layout>
