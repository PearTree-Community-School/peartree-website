import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import hero from '../assets/images/heroes/staff.jpg';
import { requestCategories } from '../data/staffRequestCategories';
import { phone, phoneTel, email } from '../data/campusInfo';

