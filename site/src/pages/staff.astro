---
import { externalForms, staffResources } from '../data/externalForms';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import hero from '../assets/images/heroes/staff.jpg';
import { requestCategories } from '../data/staffRequestCategories';
import { phone, phoneTel, email } from '../data/campusInfo';
---

<Layout title="Staff Portal" description="Pear Tree Community School staff portal — submit work requests for facilities, supplies, tech, Montessori materials, and more.">

  <PageHero
    eyebrow="Staff Portal"
    title="Submit a work request."
    subtitle="For facilities, supplies, tech, Montessori materials, or anything else you need to do your job well."
    image={hero}
    alt="Students performing under papel picado at a school showcase"
  />

  <!-- Auth-coming-soon banner -->
  <section class="bg-pear-100 border-b border-pear-200">
    <div class="section-padding py-4">
      <p class="text-sm text-charcoal max-w-4xl mx-auto"><strong>Staff portal.</strong> Work requests go to the school office through the form below.</p>
    </div>
  </section>

  <section class="section-padding">
    <div class="grid md:grid-cols-3 gap-12 max-w-6xl mx-auto">

      <!-- Categories sidebar -->
      <div class="md:col-span-1">
        <h2 class="section-heading mb-6">What can I request?</h2>
        <ul class="space-y-3">
          {requestCategories.map(c => (
            <li class="flex items-start gap-3 text-sm">
              <span class="text-forest-600 mt-1">●</span>
              <div>
                <p class="font-semibold text-charcoal">{c.label}</p>
                <p class="text-earth-600 text-xs">{c.desc}</p>
              </div>
            </li>
          ))}
        </ul>

        <div class="bg-pear-50 border border-pear-200 rounded-2xl p-6 mt-8">
          <h3 class="font-serif font-bold text-base mb-2">Urgent?</h3>
          <p class="text-sm text-earth-700 mb-3">
            If something is dangerous or blocking your class right now, please also call the front office directly.
          </p>
          <a href={phoneTel} class="text-sm text-forest-700 font-semibold underline">{phone}</a>
        </div>
      </div>

      <!-- Form -->
      <div class="md:col-span-2">
        <div class="bg-white rounded-2xl p-8 border border-earth-100">
          <h2 class="font-serif text-2xl font-bold mb-2">New request</h2>
          <p class="text-sm text-earth-700 mb-6">Required fields are marked with *. Photos are great for facilities/maintenance.</p>
          <a href={externalForms.staff} target="_blank" rel="noopener" class="underline font-semibold">Open the staff request form</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-cream border-t border-earth-100">
    <div class="max-w-4xl mx-auto">
      <h2 class="section-heading mb-2">Staff resources</h2>
      <p class="text-earth-600 mb-8">Handbooks, policies and payroll — the links staff need most.</p>
      <div class="grid sm:grid-cols-3 gap-5">
        {staffResources.map((r) => (
          <a
            href={r.href}
            target="_blank"
            rel="noopener"
            class="block bg-white rounded-xl p-6 border border-earth-100 hover:border-forest-400 transition-colors"
          >
            <p class="font-semibold text-charcoal mb-1">{r.label}</p>
            <p class="text-sm text-earth-700">{r.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>
