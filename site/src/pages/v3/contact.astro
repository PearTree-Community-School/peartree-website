---
import LayoutC from '../../layouts/LayoutC.astro';
import { campuses, phone, phoneTel, email, facebook } from '../../data/campusInfo';
---

<LayoutC title="Contact" description="Contact Pear Tree Community School in Oakland, CA.">

  <!-- Hero -->
  <section class="bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-6 py-20">
      <span class="inline-block bg-emerald-50 text-emerald-700 text-xs font-medium px-3 py-1 rounded-full uppercase tracking-wide mb-4">Contact</span>
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900 leading-tight max-w-3xl">We'd love to hear from you.</h1>
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="max-w-7xl mx-auto px-6 py-20 grid md:grid-cols-2 gap-10">

      <!-- Contact Info -->
      <div>
        <h2 class="text-2xl font-bold text-slate-900 mb-8">Get in touch</h2>

        <div class="bg-white rounded-xl p-6 border border-slate-200 mb-6">
          <div class="space-y-5">
            <div>
              <p class="text-xs uppercase tracking-wider text-slate-500 mb-1">Phone</p>
              <a href={phoneTel} class="text-emerald-700 hover:text-emerald-800 font-medium">{phone}</a>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-slate-500 mb-1">Email</p>
              <a href={`mailto:${email}`} class="text-emerald-700 hover:text-emerald-800 font-medium">{email}</a>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-slate-500 mb-1">Facebook</p>
              <a href={facebook} target="_blank" rel="noopener" class="text-emerald-700 hover:text-emerald-800 font-medium">facebook.com/peartreecs</a>
            </div>
          </div>
        </div>

        <div class="grid gap-6">
          {campuses.map(campus => (
            <div class="bg-white rounded-xl p-6 border border-slate-200">
              <h3 class="font-semibold text-slate-900 mb-2">{campus.name}</h3>
              <address class="not-italic text-sm text-slate-600 leading-relaxed">
                {campus.address}<br />
                {campus.city} {campus.zip}
              </address>
              <p class="text-xs text-slate-500 mt-2">{campus.programs}</p>
              <a href={campus.mapsUrl} target="_blank" rel="noopener" class="text-xs text-emerald-700 hover:text-emerald-800 mt-2 inline-block">View on Google Maps →</a>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

</LayoutC>
