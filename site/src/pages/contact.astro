---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import hero from '../assets/images/heroes/contact.jpg';
import { campuses, preschool, elementary, phone, phoneTel, email, facebook } from '../data/campusInfo';
import { tourCopy } from '../data/tourInfo';
import { parentFAQ } from '../data/parentFAQ';

// Most messages fall into one of a few buckets. Routing people up front means
// tour requests land in the tour flow, current families reach ParentSquare, and
// the inbox only gets the things that actually need a human reply.
const reasons = [
  {
    key: 'tour',
    label: 'Schedule a tour',
    desc: `${tourCopy.schedule}. Come and see the classrooms in person.`,
    href: '/tour/',
    cta: 'Book a tour',
    icon: 'M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z',
    tint: 'bg-pear-100 text-pear-800',
  },
  {
    key: 'admissions',
    label: 'Admissions & financial aid',
    desc: 'Enrolment steps, tuition, and the sliding scale 80% of families use.',
    href: '/admissions/',
    cta: 'How admissions works',
    icon: 'M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5',
    tint: 'bg-forest-100 text-forest-800',
  },
  {
    key: 'family',
    label: 'Current families',
    desc: 'Calendar, messages, photos, and forms live in ParentSquare.',
    href: '/parents/',
    cta: 'Open the parent portal',
    icon: 'M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z',
    tint: 'bg-earth-100 text-earth-800',
  },
  {
    key: 'give',
    label: 'Giving & partnerships',
    desc: 'Donations, employer matching, volunteering, and press.',
    href: '/support/',
    cta: 'Ways to support',
    icon: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z',
    tint: 'bg-pear-100 text-pear-800',
  },
];

// The questions prospective families ask most before they write in.
const quickAnswers = parentFAQ.filter(f =>
  /financial aid|aftercare|volunteer|drop off|sick|dress code/i.test(f.question),
);

const campusHours = `${preschool.days}, ${preschool.hours}`;
---

<Layout title="Contact" description="Contact Pear Tree Community School in Oakland, CA. Call, email, schedule a tour, or visit either campus. We reply within two business days.">

  <PageHero
    eyebrow="Contact Us"
    title="We'd love to hear from you."
    subtitle="Call, write, or come by. A real person reads every message and we reply within two business days."
    image={hero}
    alt="Students taking a bow at the Indigenous Heritage showcase"
  />

  <!-- Route the common reasons first -->
  <section class="bg-white border-b border-earth-100">
    <div class="section-padding py-12 md:py-16">
      <h2 class="font-serif text-2xl md:text-3xl font-bold text-charcoal mb-8">How can we help?</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {reasons.map(r => (
          <a href={r.href} class="group flex flex-col rounded-2xl border border-earth-100 bg-cream p-6 hover:border-forest-400 hover:shadow-md transition-all">
            <div class={`w-11 h-11 rounded-xl flex items-center justify-center mb-4 ${r.tint}`}>
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={r.icon}/></svg>
            </div>
            <h3 class="font-serif font-bold text-lg text-charcoal mb-1">{r.label}</h3>
            <p class="text-sm text-earth-700 leading-relaxed flex-1">{r.desc}</p>
            <span class="mt-4 text-sm font-semibold text-forest-700 group-hover:underline">{r.cta} &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Direct contact + composer -->
  <section class="section-padding">
    <div class="grid lg:grid-cols-5 gap-8 items-start">

      <!-- Reach us -->
      <div class="lg:col-span-2 bg-forest-900 text-white rounded-3xl p-8 md:p-10">
        <p class="text-pear-400 font-semibold text-sm uppercase tracking-widest mb-3">Reach us directly</p>
        <h2 class="font-serif text-3xl font-bold mb-8">Talk to the office.</h2>

        <dl class="space-y-7">
          <div class="flex gap-4">
            <div class="w-11 h-11 rounded-xl bg-white/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-pear-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/></svg>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wider text-forest-300 mb-1">Phone</dt>
              <dd><a href={phoneTel} class="tap-link font-serif text-2xl font-bold text-white hover:text-pear-300">{phone}</a></dd>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-11 h-11 rounded-xl bg-white/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-pear-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/></svg>
            </div>
            <div class="min-w-0">
              <dt class="text-xs uppercase tracking-wider text-forest-300 mb-1">Email</dt>
              <dd><a href={`mailto:${email}`} class="tap-link text-lg font-semibold text-white hover:text-pear-300 break-all">{email}</a></dd>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-11 h-11 rounded-xl bg-white/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-pear-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wider text-forest-300 mb-1">Campus hours</dt>
              <dd class="text-forest-100">{campusHours}</dd>
              <dd class="text-sm text-forest-300 mt-1">Messages sent after hours are answered the next school day.</dd>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-11 h-11 rounded-xl bg-white/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-pear-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21.5v-7.2h2.4l.4-2.8h-2.8V9.7c0-.8.2-1.4 1.4-1.4h1.5V5.8c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2H8v2.8h2.5v7.2h3Z"/></svg>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wider text-forest-300 mb-1">Follow along</dt>
              <dd><a href={facebook} target="_blank" rel="noopener" class="tap-link text-forest-100 hover:text-pear-300">facebook.com/peartreecs</a></dd>
            </div>
          </div>
        </dl>
      </div>

      <!-- Quick answers: the things families ask before they call or write. -->
      <div class="lg:col-span-3">
        <div class="bg-white rounded-3xl border border-earth-100 p-8 md:p-10 h-full">
          <h2 class="font-serif text-3xl font-bold text-charcoal mb-1">Quick answers</h2>
          <p class="text-earth-700 text-sm mb-4">The questions we hear most from families before they write in.</p>
          <div class="divide-y divide-earth-100">
            {quickAnswers.map(f => (
              <details class="group py-3">
                <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-serif font-bold text-charcoal">
                  <span>{f.question}</span>
                  <svg class="w-5 h-5 text-earth-500 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/></svg>
                </summary>
                <p class="text-sm text-earth-700 leading-relaxed mt-2 pr-8">{f.answer}</p>
              </details>
            ))}
          </div>
          <a href="/parents/#faq" class="inline-block mt-4 text-sm font-semibold text-forest-700 hover:underline">All parent questions &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Campuses -->
  <section class="bg-white border-y border-earth-100">
    <div class="section-padding">
      <div class="max-w-2xl mb-10">
        <h2 class="section-heading">Two campuses, one community.</h2>
        <p class="text-earth-700 leading-relaxed">
          Preschool runs at both locations. Elementary is at Chabot. Not sure which one you need? Ask when you book a tour and we will point you to the right building.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {campuses.map(campus => {
          const programs = campus.programs.includes('Elementary') ? [preschool, elementary] : [preschool];
          const q = encodeURIComponent(`${campus.address}, ${campus.city} ${campus.zip}`);
          return (
            <article class="rounded-3xl border border-earth-100 bg-cream overflow-hidden flex flex-col">
              <!-- Map loads on request: keeps the page fast and keeps Google out of the
                   visitor's browser until they ask for directions. -->
              <div class="relative aspect-[16/9] bg-forest-100 map-slot" data-q={q}>
                <div class="absolute inset-0 map-pattern" aria-hidden="true"></div>
                <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-center px-6">
                  <svg class="w-9 h-9 text-forest-700" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
                  <button type="button" class="map-load inline-flex items-center gap-2 rounded-full bg-white border border-forest-200 px-5 py-2.5 text-sm font-semibold text-forest-800 hover:border-forest-500 shadow-sm">
                    Show map
                  </button>
                </div>
              </div>

              <div class="p-7 md:p-8 flex-1 flex flex-col">
                <div class="flex flex-wrap items-center gap-2 mb-3">
                  {programs.map(p => (
                    <span class="inline-block rounded-full bg-forest-100 text-forest-800 text-xs font-semibold px-3 py-1">{p.name}</span>
                  ))}
                </div>
                <h3 class="font-serif text-2xl font-bold text-charcoal mb-2">{campus.name}</h3>
                <address class="not-italic text-earth-700 leading-relaxed mb-5">
                  {campus.address}<br />
                  {campus.city} {campus.zip}
                </address>

                <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-sm mb-6">
                  {programs.map(p => (
                    <>
                      <dt class="text-earth-700">{p.name}</dt>
                      <dd class="text-charcoal font-medium">{p.days}, {p.hours}</dd>
                    </>
                  ))}
                </dl>

                <div class="mt-auto flex flex-wrap gap-3">
                  <a href={campus.mapsUrl} target="_blank" rel="noopener" class="btn-primary text-sm px-5 py-2.5">Get directions</a>
                  <a href={`https://maps.apple.com/?q=${q}`} target="_blank" rel="noopener" class="btn-secondary text-sm px-5 py-2.5">Apple Maps</a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Good to know -->
  <section class="section-padding py-12 md:py-16">
    <div class="grid sm:grid-cols-3 gap-6">
      <div class="flex gap-4">
        <span class="font-serif text-4xl font-bold text-forest-700 leading-none">2</span>
        <p class="text-sm text-earth-700 leading-relaxed"><strong class="text-charcoal block">business days</strong>is our usual reply time for email and voicemail.</p>
      </div>
      <div class="flex gap-4">
        <span class="font-serif text-4xl font-bold text-forest-700 leading-none">Thu</span>
        <p class="text-sm text-earth-700 leading-relaxed"><strong class="text-charcoal block">tour day</strong>Tours run every Thursday. <a href="/tour/" class="text-forest-700 underline underline-offset-2">Book one</a>.</p>
      </div>
      <div class="flex gap-4">
        <span class="font-serif text-4xl font-bold text-forest-700 leading-none">80%</span>
        <p class="text-sm text-earth-700 leading-relaxed"><strong class="text-charcoal block">of families receive aid</strong>Ask us about the sliding scale before you rule anything out.</p>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Soft grid behind the "Show map" button so the slot reads as a map, not a hole. */
  .map-pattern {
    background-image:
      linear-gradient(to right, rgba(35, 93, 51, 0.10) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(35, 93, 51, 0.10) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse at center, black 40%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 85%);
  }
</style>

<script>
  // Maps: swap the placeholder for an embed only when asked.
  for (const slot of document.querySelectorAll('.map-slot')) {
    slot.querySelector('.map-load')?.addEventListener('click', () => {
      const q = slot.getAttribute('data-q');
      const frame = document.createElement('iframe');
      frame.src = `https://www.google.com/maps?q=${q}&output=embed`;
      frame.title = 'Map';
      frame.loading = 'lazy';
      frame.referrerPolicy = 'no-referrer-when-downgrade';
      frame.className = 'absolute inset-0 w-full h-full border-0';
      slot.replaceChildren(frame);
    });
  }
</script>
