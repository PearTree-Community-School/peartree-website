---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { campuses, phone, email } from '../data/campusInfo';
import { analytics, social } from '../data/site';
import logo from '../assets/images/logo.jpg';
// Self-hosted fonts: no third-party request, no render-blocking stylesheet from
// another origin, and font-display: swap out of the box. Weights match what the
// design actually uses (see tailwind.config.mjs fontFamily).
import '@fontsource/lora/500.css';
import '@fontsource/lora/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Pear Tree Community School — A social justice Montessori school in Oakland, CA serving preschool through 5th grade.' } = Astro.props;
const selfHosted = process.env.SITE_SELF_HOSTED === '1';

// Absolute URLs — Open Graph and canonical tags are both ignored when relative.
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://peartreecs.com');
const socialImage = new URL('/og-image.jpg', Astro.site ?? 'https://peartreecs.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#1a3d24" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`/favicon.svg`} />
    <title>{title} | Pear Tree Community School</title>

    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | Pear Tree Community School`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Pear Tree Community School" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pear Tree students showcasing their artwork" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Pear Tree Community School`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <!-- Schema.org School markup -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "School",
      "name": "Pear Tree Community School",
      "description": "A social justice-informed Montessori school serving preschool through 5th grade in Oakland, CA.",
      "address": campuses.map(campus => ({
        "@type": "PostalAddress",
        "streetAddress": campus.address,
        "addressLocality": "Oakland",
        "addressRegion": "CA",
        "postalCode": campus.zip,
      })),
      "telephone": phone,
      "email": email,
      "url": "https://peartreecs.com",
      "logo": new URL(logo.src, Astro.site ?? 'https://peartreecs.com').toString(),
      "image": socialImage.toString(),
      "sameAs": [social.facebook],
      "foundingDate": "2012",
      "founder": {
        "@type": "Person",
        "name": "Michele Hamilton"
      }
    })} />
    {selfHosted && <script src="/overlay.js" defer is:inline></script>}
    {analytics.domain && <script defer data-domain={analytics.domain} src={analytics.scriptSrc} is:inline></script>}
  </head>
  <body class="flex flex-col min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60] focus:rounded-lg focus:bg-forest-800 focus:px-4 focus:py-2 focus:text-white focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-pear-400"
    >Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
