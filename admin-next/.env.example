# Payload (any 32+ char random string; openssl rand -hex 32)
PAYLOAD_SECRET=replace-with-32-plus-random-characters

# SQLite database path (auto-created)
DATABASE_URI=file:./data/admin.sqlite

# WorkOS AuthKit
WORKOS_API_KEY=sk_test_replace_me
WORKOS_CLIENT_ID=client_replace_me
WORKOS_COOKIE_PASSWORD=replace-with-32-plus-random-characters
WORKOS_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# Optional: scope WorkOS users to one organization
# WORKOS_ORGANIZATION_ID=org_replace_me

# Optional: WorkOS webhook signing secret (Dashboard → Webhooks → Signing secret)
# WORKOS_WEBHOOK_SECRET=whsec_...

# Bootstrap super_admin (comma-separated emails). Used only when users table is empty.
# ADMIN_BOOTSTRAP_EMAILS=admin@peartree.org

# Public site URL (where sign-out redirects)
PUBLIC_SITE_BASE_URL=https://peartree-community-school.github.io/peartree-website

# Admin app base URL (for cookie security inference)
ADMIN_BASE_URL=http://127.0.0.1:3000
